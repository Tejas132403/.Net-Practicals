<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />

    <title>
        @ViewBag.Title - Feedback Management
    </title>

    <style>
        body {
            font-family: Arial;
            margin: 0;
        }

        header {
            background-color: darkblue;
            color: white;
            padding: 20px;
        }

        main {
            padding: 30px;
        }

        footer {
            background-color: lightgray;
            padding: 15px;
            text-align: center;
        }

        .form-control {
            width: 300px;
            padding: 8px;
        }
    </style>
</head>

<body>

    <header>
        <h1>Feedback Management System</h1>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>© 2026 Feedback Management</p>
    </footer>

</body>
</html>
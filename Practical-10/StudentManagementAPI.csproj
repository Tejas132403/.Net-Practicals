<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <Target Name="RemoveStaticWebAssetsRuntimeJson" AfterTargets="Build">
    <Delete Files="$(TargetDir)$(TargetName).staticwebassets.runtime.json" Condition="Exists('$(TargetDir)$(TargetName).staticwebassets.runtime.json')" />
  </Target>

</Project>

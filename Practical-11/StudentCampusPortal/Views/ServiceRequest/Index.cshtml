@model IEnumerable<StudentCampusPortal.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Campus Service Requests</h2>
        <p class="text-muted mb-0">Manage all student maintenance, IT, library, and transportation requests</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            + Create New Request
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Req ID</th>
                        <th>Student Name</th>
                        <th>Department</th>
                        <th>Service Type</th>
                        <th>Description</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">#@item.RequestId</td>
                                <td class="fw-semibold">@item.StudentName</td>
                                <td>@item.Department</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.ServiceType</span>
                                </td>
                                <td class="text-truncate" style="max-width: 250px;" title="@item.Description">
                                    @item.Description
                                </td>
                                <td>
                                    @if (item.Priority == "High")
                                    {
                                        <span class="badge bg-danger">High</span>
                                    }
                                    else if (item.Priority == "Medium")
                                    {
                                        <span class="badge bg-warning text-dark">Medium</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Low</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (item.Status == "In Progress")
                                    {
                                        <span class="badge bg-info text-dark">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td class="text-muted small">@item.RequestDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="UpdateStatus" asp-route-id="@item.RequestId" class="btn btn-outline-primary" title="Update Status">
                                            Update Status
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.RequestId" class="btn btn-outline-secondary" title="Details">
                                            Details
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <h5>No service requests found</h5>
                                <p>Get started by submitting a new request!</p>
                                <a asp-action="Create" class="btn btn-primary btn-sm">+ Create New Request</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
